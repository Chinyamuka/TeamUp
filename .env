# ============================================================
# FLASK CORE SETTINGS
# ============================================================
FLASK_APP=run.py
FLASK_ENV=development  # This tells Flask to use DevelopmentConfig
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production

# ============================================================
# DATABASE - PostgreSQL (SRS Section 2.4)
# ============================================================
# For development, we use PostgreSQL via Docker
# Make sure PostgreSQL is running before starting the app
DATABASE_URL=postgresql://adon:dc%405400-Zactech@localhost:5432/teamup_db

# If PostgreSQL is not running, uncomment the line below to use SQLite temporarily
# DATABASE_URL=sqlite:///teamup_dev.db

# ============================================================
# REDIS - Cache & Backplane (SRS Section 6.3)
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# RABBITMQ - Message Queue (SRS Section 6.4)
# ============================================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# ============================================================
# CELERY - Background Tasks (SRS Section 3.8)
# ============================================================
CELERY_BROKER_URL=${RABBITMQ_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# ============================================================
# RATE LIMITING (SRS Section 3.7, FR-7.1)
# ============================================================
RATE_LIMIT_DEFAULT=1000/hour
RATE_LIMIT_AUTH=100/hour

# ============================================================
# CORS - Cross-Origin Requests (SRS Section 2.1)
# ============================================================
CORS_ORIGINS=http://localhost:3000
SOCKETIO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================================
# LOGGING (SRS Section 4.6, NFR-17)
# ============================================================
LOG_LEVEL=DEBUG
